# /etc/systemd/system/x-engine.service
# Install:  sudo cp deploy/x-engine.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now x-engine
[Unit]
Description=X-engine XAU/USD trading bot + MCP server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=xengine
WorkingDirectory=/opt/x-engine
EnvironmentFile=/opt/x-engine/.env
ExecStart=/opt/x-engine/.venv/bin/python launch.py --forever --http --port 8765
# SIGTERM → launch.py saves the models before exiting
KillSignal=SIGTERM
TimeoutStopSec=60
# Restart only after a crash (exit 1 / signal). Never after a clean stop (0 = emergency_stop)
# or a config error (78 = fix .env first). Delay grows 5 s → 10 min so a persistent failure
# cannot hammer IG's login endpoint.
Restart=on-failure
RestartPreventExitStatus=0 78
RestartSec=5
RestartSteps=8
RestartMaxDelaySec=600
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/x-engine/logs /opt/x-engine/models
PrivateTmp=true

[Install]
WantedBy=multi-user.target
